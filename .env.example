MONGODB_URI=mongodb://127.0.0.1:27017/dreamrobotics
# Secret key required in the "x-admin-key" header for create/update/delete APIs
ADMIN_KEY=change-this-secret-key

# Admin login at /admin (created by `npm run seed`; re-run seed after changing the password)
ADMIN_NAME=Rahul Kumar
ADMIN_EMAIL=admin@dreamrobotics.in
ADMIN_PASSWORD=Admin@12345
# Signs the admin login cookie — use a long random string
AUTH_SECRET=change-this-long-random-string
